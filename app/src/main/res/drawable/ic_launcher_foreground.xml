<?xml version="1.0" encoding="utf-8"?>
<!--
    Samsung Remote - adaptive icon foreground.

    A small remote in the same moulded plastic as the app: a body with a bright top rim and a
    drop shadow, a glowing red power key, a status lamp, a navigation wheel sunk into a recess
    with a raised OK disc, and two small keys below.

    All geometry sits inside the 66dp safe circle (centre 54,54 radius 33), so nothing is
    clipped by any launcher mask. Body: x 36..72, y 23..85, corner radius 13.

    The monochrome layer for themed icons is a separate drawable (ic_launcher_monochrome),
    because this one depends on colour and gradients to read correctly.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Drop shadow under the body. -->
    <group android:translateY="2.5">
        <path
            android:fillColor="#80000000"
            android:pathData="M49,23 H59 A13,13 0 0 1 72,36 V72 A13,13 0 0 1 59,85 H49 A13,13 0 0 1 36,72 V36 A13,13 0 0 1 49,23 Z" />
    </group>

    <!-- Body. -->
    <path android:pathData="M49,23 H59 A13,13 0 0 1 72,36 V72 A13,13 0 0 1 59,85 H49 A13,13 0 0 1 36,72 V36 A13,13 0 0 1 49,23 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="23"
                android:endX="54" android:endY="85"
                android:startColor="#FF474751"
                android:endColor="#FF23232A" />
        </aapt:attr>
    </path>

    <!-- Rim: bright along the top edge, fading out towards the bottom. -->
    <path
        android:strokeWidth="1.2"
        android:pathData="M49,23.6 H59 A12.4,12.4 0 0 1 71.4,36 V72 A12.4,12.4 0 0 1 59,84.4 H49 A12.4,12.4 0 0 1 36.6,72 V36 A12.4,12.4 0 0 1 49,23.6 Z">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="23"
                android:endX="54" android:endY="85"
                android:startColor="#73FFFFFF"
                android:endColor="#08FFFFFF" />
        </aapt:attr>
    </path>

    <!-- Status lamp, top left: a green pinhole with its halo. -->
    <path android:pathData="M39.5,30 A3.5,3.5 0 1 0 46.5,30 A3.5,3.5 0 1 0 39.5,30 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="43" android:centerY="30"
                android:gradientRadius="3.5"
                android:startColor="#993ED16A"
                android:endColor="#003ED16A" />
        </aapt:attr>
    </path>
    <path
        android:fillColor="#FF3ED16A"
        android:pathData="M41.7,30 A1.3,1.3 0 1 0 44.3,30 A1.3,1.3 0 1 0 41.7,30 Z" />

    <!-- Power key: a red glow bleeding into the plastic, then the key itself. -->
    <path android:pathData="M44,35.5 A10,10 0 1 0 64,35.5 A10,10 0 1 0 44,35.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54" android:centerY="35.5"
                android:gradientRadius="10"
                android:startColor="#8CE0404A"
                android:endColor="#00E0404A" />
        </aapt:attr>
    </path>
    <path android:pathData="M48.5,35.5 A5.5,5.5 0 1 0 59.5,35.5 A5.5,5.5 0 1 0 48.5,35.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="30"
                android:endX="54" android:endY="41"
                android:startColor="#FFE64E56"
                android:endColor="#FFAD2027" />
        </aapt:attr>
    </path>
    <path
        android:strokeColor="#40FFFFFF"
        android:strokeWidth="0.6"
        android:pathData="M48.8,35.5 A5.2,5.2 0 1 0 59.2,35.5 A5.2,5.2 0 1 0 48.8,35.5 Z" />
    <!-- Power glyph: an open ring with a bar through the gap. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.1"
        android:strokeLineCap="round"
        android:pathData="M56.25,34.2 A2.6,2.6 0 1 1 51.75,34.2" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.1"
        android:strokeLineCap="round"
        android:pathData="M54,31.9 V35.3" />

    <!-- Navigation wheel: a recess cut into the body, dark under its lip. -->
    <path android:pathData="M39,60 A15,15 0 1 0 69,60 A15,15 0 1 0 39,60 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="45"
                android:endX="54" android:endY="75"
                android:startColor="#FF0D0D11"
                android:endColor="#FF1F1F26" />
        </aapt:attr>
    </path>
    <!-- The wheel itself, raised inside the recess. -->
    <path android:pathData="M40.8,60 A13.2,13.2 0 1 0 67.2,60 A13.2,13.2 0 1 0 40.8,60 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="46.8"
                android:endX="54" android:endY="73.2"
                android:startColor="#FF3E3E48"
                android:endColor="#FF26262E" />
        </aapt:attr>
    </path>
    <path
        android:strokeColor="#2EFFFFFF"
        android:strokeWidth="0.8"
        android:pathData="M41.2,60 A12.8,12.8 0 1 0 66.8,60 A12.8,12.8 0 1 0 41.2,60 Z" />
    <!-- Arrows, out near the rim. -->
    <path
        android:fillColor="#FFDADAE0"
        android:pathData="M54,49.3 L52.2,52.1 H55.8 Z M54,70.7 L52.2,67.9 H55.8 Z M43.3,60 L46.1,58.2 V61.8 Z M64.7,60 L61.9,58.2 V61.8 Z" />
    <!-- OK disc, standing proud of the wheel. -->
    <group android:translateY="0.9">
        <path
            android:fillColor="#73000000"
            android:pathData="M47.8,60 A6.2,6.2 0 1 0 60.2,60 A6.2,6.2 0 1 0 47.8,60 Z" />
    </group>
    <path android:pathData="M48.2,60 A5.8,5.8 0 1 0 59.8,60 A5.8,5.8 0 1 0 48.2,60 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="54.2"
                android:endX="54" android:endY="65.8"
                android:startColor="#FF4E4E59"
                android:endColor="#FF30303A" />
        </aapt:attr>
    </path>
    <path
        android:strokeColor="#4DFFFFFF"
        android:strokeWidth="0.7"
        android:pathData="M48.55,60 A5.45,5.45 0 1 0 59.45,60 A5.45,5.45 0 1 0 48.55,60 Z" />

    <!-- Two small keys below the wheel. -->
    <path
        android:fillColor="#FF3C3C46"
        android:pathData="M44,76.5 H49.5 A2,2 0 0 1 49.5,80.5 H44 A2,2 0 0 1 44,76.5 Z M58.5,76.5 H64 A2,2 0 0 1 64,80.5 H58.5 A2,2 0 0 1 58.5,76.5 Z" />
    <path
        android:strokeColor="#33FFFFFF"
        android:strokeWidth="0.6"
        android:pathData="M44.3,76.8 H49.2 M58.8,76.8 H63.7" />

</vector>
