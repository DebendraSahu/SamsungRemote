<?xml version="1.0" encoding="utf-8"?>
<!--
    Samsung Remote - adaptive icon background.

    The same dark moulded plastic as the app's shell, lit from above: a vertical gradient
    with a soft highlight behind the remote so the body reads as standing proud of it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="0"
                android:endX="54" android:endY="108"
                android:startColor="#FF30303A"
                android:endColor="#FF101015" />
        </aapt:attr>
    </path>

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54" android:centerY="44"
                android:gradientRadius="52"
                android:startColor="#26FFFFFF"
                android:endColor="#00FFFFFF" />
        </aapt:attr>
    </path>

</vector>
